---
import BaseLayout from '../layouts/BaseLayout.astro';
import Content from '../../content/news.md';
import Card from '../components/Card.astro';
import news from '../../data/news.yml';

// YYYY-MM and YYYY remain partial dates. Their lexical order is chronological.
const items = [...news].sort((a, b) => String(b.date).localeCompare(String(a.date)));
---
<BaseLayout title="News — Samuel Somot">
  <div class="page-stack">
    <article class="prose intro-only"><Content /></article>
    <section>
      {items.length ? <div class="grid two">{items.map((item) => <Card title={item.title} eyebrow={String(item.date)} href={item.url || undefined}>
        <p>{item.summary}</p>
        <ul class="news-keywords" aria-label={`Keywords for ${item.title}`}>{item.keywords.map((keyword) => <li>{keyword}</li>)}</ul>
      </Card>)}</div> : <div class="empty-state"><h2>Archive ready</h2><p>No entries are published yet. Verified news can be added to <code>data/news.yml</code>.</p></div>}
      <p class="linkedin-cta"><a class="button" href="https://www.linkedin.com/in/sam-somot/">Follow me on LinkedIn ↗</a></p>
    </section>
  </div>
</BaseLayout>
