---
import BaseLayout from '../layouts/BaseLayout.astro';
import Content from '../../content/projects-communities.md';
import CommunityCard from '../components/CommunityCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import communities from '../../data/communities.yml';
import projects from '../../data/projects.yml';

const active = communities.filter((item) => item.status === 'active');
const finished = communities.filter((item) => item.status === 'finished');
const current = projects.filter((item) => item.status === 'current');
const past = projects.filter((item) => item.status === 'past');
---
<BaseLayout title="Projects & Communities — Samuel Somot">
  <div class="page-stack">
    <article class="prose intro-only"><Content /></article>
    <section>
      <h2>Scientific communities & programmes</h2>
      <h3 class="subheading">Active communities</h3>
      <div class="communities-grid">{active.map((community) => <CommunityCard community={community} />)}</div>
      {finished.length > 0 && <><h3 class="subheading">Finished programmes</h3><div class="communities-grid">{finished.map((community) => <CommunityCard community={community} />)}</div></>}
    </section>
    <section class="projects-section">
      <h2>Current projects</h2>
      <div class="projects-grid">{current.map((project) => <ProjectCard project={project} />)}</div>
    </section>
    <section class="projects-section">
      <h2>Past projects</h2>
      <div class="projects-list">{past.map((project) => <ProjectCard project={project} compact />)}</div>
    </section>
  </div>
</BaseLayout>
